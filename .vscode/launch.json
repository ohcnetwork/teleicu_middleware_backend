  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: Django",
      "type": "debugpy",
      "request": "attach",
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
